DATABASE_URL=sqlite:///./mixlab.db
# En prod: postgresql+psycopg://user:pass@host/db
SECRET_KEY=change-me-long-random-string
STORAGE_DIR=./storage
TRIAL_DAYS=7
MAX_UPLOAD_MB=50
MAX_DURATION_SEC=420
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
APP_URL=http://localhost:8000
# Déploiement Docker
DOMAIN=mixlab.tondomaine.com
DB_PASSWORD=un-mot-de-passe-long
# E-mails (mot de passe oublié). Sans SMTP, le lien s'affiche seulement dans les logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MixLab AI <no-reply@tondomaine.com>
# PayPal (abonnements)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
